@using System.Text.Json
@model Fastkart.Models.Entities.Order
@{
    Layout = "_LayoutAdmin";
    ViewData["title"] = "Order Detail";

    decimal subtotal = Model.OrderItems.Sum(x => x.PriceAtPurchase * x.Quantity);
    decimal shipping = 25000; 
    decimal tax = 0;
}

<div class="header-title">
    <h5>Order #@Model.Uid</h5>
    <div class="options-order">
        <span>@Model.OrderDate.ToString("MMMM dd, yyyy at h:mm tt")</span>
        <span>/</span>
        <span>@Model.OrderItems.Sum(x => x.Quantity) items</span>
        <span>/</span>
        <span>Total @Model.TotalAmount.ToString("N0") ₫</span>
        <span>/</span>
        <span class="badge @(Model.Status == "Paid" || Model.Status == "Delivered" ? "bg-success" : "bg-warning text-dark")">
            @Model.Status
        </span>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card card-table">
            <div class="header-title">
                <h5>ITEMS</h5>
                <div class="options">
                </div>
            </div>

            <div class="table-responsive profile-table">
                <table class="table theme-table mb-0">
                    <tbody>
                        @foreach (var item in Model.OrderItems)
                        {
                            string imgUrl = "/assets/images/product/default.png";
                            if (item.Product != null && !string.IsNullOrWhiteSpace(item.Product.Thumbnail))
                            {
                                try
                                {
                                    var thumbnails = JsonSerializer.Deserialize<List<string>>(item.Product.Thumbnail);
                                    if (thumbnails != null && thumbnails.Any()) imgUrl = thumbnails.First();
                                }
                                catch { imgUrl = item.Product.Thumbnail; }
                            }

                            <tr>
                                <td>
                                    <div class="table-image">
                                        <img src="@imgUrl" alt="@item.Product?.ProductName" class="img-fluid" style="width: 60px; height: 60px; object-fit: cover;" />
                                    </div>
                                </td>
                                <td>
                                    <div class="user-name">
                                        <span>@(item.Product?.ProductName ?? "Sản phẩm đã xóa")</span>
                                    </div>
                                </td>
                                <td>Quantity: @item.Quantity</td>
                                <td>@item.PriceAtPurchase.ToString("N0") ₫</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer">
                <div class="order-total-table">
                    <div class="table-responsive">
                        <table class="table theme-table mb-0">
                            <tbody>
                                <tr>
                                    <td>Subtotal</td>
                                    <td>@subtotal.ToString("N0") ₫</td>
                                </tr>
                                <tr>
                                    <td>Shipping</td>
                                    <td>@shipping.ToString("N0") ₫</td>
                                </tr>
                                <tr>
                                    <td>Tax(GST)</td>
                                    <td>@tax.ToString("N0") ₫</td>
                                </tr>
                                <tr>
                                    <td class="fs-5 fw-bold">Total Price :</td>
                                    <td class="fs-5 fw-bold text-success">@Model.TotalAmount.ToString("N0") ₫</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Summary</h5>
                <ul class="summery-list">
                    <li>
                        <span>Order ID:</span> #@Model.Uid
                    </li>
                    <li>
                        <span>Order Date:</span> @Model.OrderDate.ToString("MMMM dd, yyyy")
                    </li>
                    <li>
                        <span>Order Total:</span> @Model.TotalAmount.ToString("N0") ₫
                    </li>
                </ul>
            </div>

            <div class="card-body">
                <h5 class="card-title">Shipping Address</h5>
                <ul class="summery-list">
                    <li>
                        <span>Name:</span> @(Model.User?.FullName ?? "Guest")
                    </li>
                    <li>
                        <span>Address:</span> @Model.ShippingAddress
                    </li>
                    <li>
                        <span>Contact No:</span> @(Model.User?.PhoneNumber ?? "N/A")
                    </li>
                    <li>
                        <span>Email:</span> @(Model.User?.Email ?? "N/A")
                    </li>
                </ul>
            </div>

            <div class="card-body">
                <h5 class="card-title">Payment Method</h5>
                <ul class="summery-list">
                    <li>
                        <span>@Model.PaymentMethod</span>
                        <p class="text-muted small">
                            Status: <span class="badge bg-secondary">@Model.Status</span>
                        </p>
                    </li>
                </ul>
            </div>

            <div class="card-body bg-light">
                <h5 class="card-title">Update Status</h5>
                <form action="/admin/orders/update-status" method="post">
                    <input type="hidden" name="id" value="@Model.Uid" />

                    <select name="status" class="form-select mb-2">
                        <option value="Pending_Payment" selected="@(Model.Status == "Pending_Payment")">Pending Payment</option>
                        <option value="Pending_COD" selected="@(Model.Status == "Pending_COD")">Pending (COD)</option>
                        <option value="Processing" selected="@(Model.Status == "Processing")">Processing</option>
                        <option value="Shipped" selected="@(Model.Status == "Shipped")">Shipped</option>
                        <option value="Delivered" selected="@(Model.Status == "Delivered")">Delivered</option>
                        <option value="Paid" selected="@(Model.Status == "Paid")">Paid</option>
                        <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Cancelled</option>
                    </select>

                    <button type="submit" class="btn btn-process btn-animation btn-primary w-100">Update Status</button>
                </form>
            </div>

            @if (!string.IsNullOrEmpty(TempData["SuccessMessage"] as string))
            {
                <div class="alert alert-success mt-3">
                    @TempData["SuccessMessage"]
                </div>
            }

        </div>
    </div>
</div>