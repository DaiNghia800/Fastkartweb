@using System.Text.Json
@model List<Fastkart.Models.Entities.Order>
@{
    Layout = "_LayoutAdmin";
    ViewData["title"] = "Order List";
    string currentSearch = ViewData["CurrentSearch"] as string;
}

<section class="order-area">
    <div class="card card-table">
        <div class="header-title">
            <h5>Order List</h5>
            <div class="options">
                <ul>
                    <li>
                        <a href="/admin/orders/export?search=@currentSearch" class="btn btn-success">
                            Export
                        </a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="table-responsive">
            <div class="table-search">
                <form action="/admin/orders" method="get">
                    <label>
                        Search:
                        <input type="text" name="search" value="@currentSearch" placeholder="Search order..." />
                    </label>
                    
                    <button type="submit" style="display: none;"></button>
                </form>
            </div>
            <table class="table theme-table mb-0">
                <thead>
                    <tr>
                        <th>Order Image</th>
                        <th class="text-start">Order Code</th>
                        <th class="text-start">Date</th>
                        <th>Payment Method</th>
                        <th>Delivery Status</th>
                        <th>Amount</th>
                        <th>Option</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            if (@item.Deleted == false)
                            {
                                var firstItem = item.OrderItems.FirstOrDefault();
                                string firstImg = "/assets/images/product/default.png";

                                if (firstItem != null && firstItem.Product != null && !string.IsNullOrWhiteSpace(firstItem.Product.Thumbnail))
                                {
                                    try
                                    {
                                        var thumbnails = JsonSerializer.Deserialize<List<string>>(firstItem.Product.Thumbnail);
                                        if (thumbnails != null && thumbnails.Any())
                                        {
                                            firstImg = thumbnails.FirstOrDefault();
                                        }
                                    }
                                    catch
                                    {
                                        firstImg = firstItem.Product.Thumbnail;
                                    }
                                }

                                <tr>
                                    <td>
                                        <div class="table-img">
                                            <a href="/admin/orders/details/@item.Uid">
                                                <img src="@firstImg" alt="order-img" class="img-fluid" style="width: 50px; height: 50px; object-fit: cover;" />
                                            </a>
                                        </div>
                                    </td>
                                    <td class="text-start">#@item.Uid</td>
                                    <td class="text-start">@item.OrderDate.ToString("MMM dd, yyyy")</td>
                                    <td>@item.PaymentMethod</td>
                                    <td>
                                        @if (item.Status == "Paid" || item.Status == "Delivered" || item.Status == "Success")
                                        {
                                            <span class="badge bg-success">Success</span>
                                        }
                                        else if (item.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger">Cancelled</span>
                                        }
                                        else if (item.Status.Contains("Pending"))
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                        else if (item.Status == "Shipped")
                                        {
                                            <span class="badge bg-primary">Shipped</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@item.Status</span>
                                        }
                                    </td>
                                    <td>@item.TotalAmount.ToString("N0") ₫</td>
                                    <td>
                                        <ul class="d-flex align-items-center">
                                            <li>
                                                <a href="/admin/orders/details/@item.Uid" class="icon-detail" title="View Detail">
                                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12.0003 3C17.3924 3 21.8784 6.87976 22.8189 12C21.8784 17.1202 17.3924 21 12.0003 21C6.60812 21 2.12215 17.1202 1.18164 12C2.12215 6.87976 6.60812 3 12.0003 3ZM12.0003 19C16.2359 19 19.8603 16.052 20.7777 12C19.8603 7.94803 16.2359 5 12.0003 5C7.7646 5 4.14022 7.94803 3.22278 12C4.14022 16.052 7.7646 19 12.0003 19ZM12.0003 16.5C9.51498 16.5 7.50026 14.4853 7.50026 12C7.50026 9.51472 9.51498 7.5 12.0003 7.5C14.4855 7.5 16.5003 9.51472 16.5003 12C16.5003 14.4853 14.4855 16.5 12.0003 16.5ZM12.0003 14.5C13.381 14.5 14.5003 13.3807 14.5003 12C14.5003 10.6193 13.381 9.5 12.0003 9.5C10.6196 9.5 9.50026 10.6193 9.50026 12C9.50026 13.3807 10.6196 14.5 12.0003 14.5Z"></path></svg>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="javascript:void(0)" onclick="deleteOrderConfirm(@item.Uid)" class="icon-delete" title="Delete">
                                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M7 4V2H17V4H22V6H20V21C20 21.5523 19.5523 22 19 22H5C4.44772 22 4 21.5523 4 21V6H2V4H7ZM6 6V20H18V6H6ZM9 9H11V17H9V9ZM13 9H15V17H13V9Z"></path></svg>
                                                </a>
                                            </li>
                                        </ul>
                                    </td>
                                </tr>
                            }
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center p-5">
                                <h5 class="text-muted">No orders found.</h5>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <nav class="box-page pro">
            <ul class="d-flex justify-content-center gap-2">
                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a href="" button-pagination=@(ViewBag.CurrentPage - 1)>
                        <i class="fa-solid fa-angles-left p-0"></i>
                    </a>
                </li>
                @{
                    for (int i = 1; i <= ViewBag.TotalPage; i++)
                    {
                        <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                            <a href="" button-pagination=@i>
                                @i
                            </a>
                        </li>
                    }
                }
                <li class="page-item @(ViewBag.TotalPage == ViewBag.CurrentPage ? "disabled" : "")">
                    <a href="" button-pagination=@(ViewBag.CurrentPage + 1)>
                        <i class="fa-solid fa-angles-right p-0"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</section>
@section Scripts {
    <script>
        function deleteOrderConfirm(orderId) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '/admin/orders/delete/' + orderId;
                }
            })
        }
    </script>
}
