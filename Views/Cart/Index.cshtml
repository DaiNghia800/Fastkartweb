@using System.Text.Json
@model List<Fastkart.Models.Entities.CartItemViewModel>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Cart";
    long subtotal = (long)(ViewBag.Subtotal ?? 0L);
    long shippingFee = 25000;
    long couponDiscount = 0;

    long grandTotal = subtotal + shippingFee - couponDiscount;
}

<section class="cart-section">
    <div class="container">
        <div class="row g-sm-5 g-3">
            <div class="col-12">
                <div class="cart-left">
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    @foreach (var item in Model)
                                    {
                                        <tr class="product-row" data-product-id="@item.ProductId">
                                            <td class="product-detail">
                                                <div class="product d-flex align-items-center">
                                                    <a href="#">
                                                        @{
                                                            var thumbnails = string.IsNullOrWhiteSpace(item.Image)
                                                            ? new List<string>()
                                                            : System.Text.Json.JsonSerializer.Deserialize<List<string>>(item.Image);

                                                            var firstImg = thumbnails.FirstOrDefault();
                                                        }
                                                        <img src="@firstImg" alt="@item.ProductName" class="img-fluid">
                                                    </a>
                                                    <div class="detail">
                                                        <ul>
                                                            <li class="name">
                                                                <a href="#">@item.ProductName</a>
                                                            </li>
                                                            <li class="text-content">
                                                                <span>Sold By:</span> Fresho
                                                            </li>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="price">
                                                <h4 class="table-title">Price</h4>
                                                <h5>@item.Price.ToString("N0") ₫</h5>
                                            </td>
                                            <td class="qty">
                                                <h4 class="table-title">Qty</h4>
                                                <div class="cart-qty">
                                                    <div class="input-group">
                                                        <button type="button" class="btn qty-left-minus btn-update-qty" data-action="minus">
                                                            <i class="fa fa-minus ms-0"></i>
                                                        </button>

                                                        <input class="form-control input-number qty-input" type="text" name="quantity" value="@item.Quantity" readonly>

                                                        <button type="button" class="btn qty-right-plus btn-update-qty" data-action="plus">
                                                            <i class="fa fa-plus ms-0"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="total">
                                                <h4 class="table-title">Total</h4>
                                                <h5>@item.Total.ToString("N0") ₫</h5>
                                            </td>
                                            <td class="action">
                                                <h4 class="table-title">Action</h4>

                                                <a href="javascript:void(0)" class="save btn-save-later" data-product-id="@item.ProductId">Save for later</a>

                                                <a href="javascript:void(0)" class="remove btn-remove-cart" data-product-id="@item.ProductId">Remove</a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" style="text-align: center; padding: 30px;">
                                            <h4>Your cart is empty.</h4>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-12">
                <div class="cart-right">
                    <div class="cart-right-contain">
                        <div class="summery-contain">
                            <div class="coupon-cart">
                                <h6>Coupon Apply</h6>
                                <div class="coupon-box input-group mb-3">
                                    <input type="text" class="form-control" placeholder="Enter Coupon Code Here...">
                                    <button class="btn-apply">Apply</button>
                                </div>
                            </div>
                            <ul>
                                <li>
                                    <h4>Subtotal</h4>
                                    <h4 class="price">@subtotal.ToString("N0") ₫</h4>
                                </li>
                                <li>
                                    <h4>Coupon Discount</h4>
                                    <h4 class="price">(-) @couponDiscount.ToString("N0") ₫</h4>
                                </li>
                                <li>
                                    <h4>Shipping</h4>
                                    <h4 class="price">@shippingFee.ToString("N0") ₫</h4>
                                </li>
                            </ul>
                        </div>
                        <div class="cart-right-total">
                            <h4>Total (VND)</h4>
                            <h4 class="price">@grandTotal.ToString("N0") ₫</h4>
                        </div>
                        <div class="button-group">
                            <div>
                                <a href="/checkout" class="btn fw-bold btn-animation w-100">Process To Checkout</a>
                            </div>
                            <div>
                                <a href="/" class="btn btn-light text-dark button-shopping">
                                    <i class="fa-solid fa-arrow-left-long me-2"></i>
                                    Return To Shopping
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // --- 1. HANDLE UPDATE QUANTITY (PLUS / MINUS) ---
            const updateButtons = document.querySelectorAll('.btn-update-qty');

            updateButtons.forEach(btn => {
                btn.addEventListener('click', function (e) {
                    e.preventDefault();
                    const row = this.closest('.product-row');
                    const productId = row.dataset.productId;
                    const input = row.querySelector('.qty-input');
                    let currentQty = parseInt(input.value);
                    const action = this.dataset.action;

                    let quantityToSend = 0;

                    if (action === 'plus') {
                        quantityToSend = 1;
                    } else if (action === 'minus') {
                        if (currentQty > 1) {
                            quantityToSend = -1;
                        } else {
                            // Dùng SweetAlert thay cho confirm
                            Swal.fire({
                                title: 'Are you sure?',
                                text: "Do you want to remove this item from your cart?",
                                icon: 'warning',
                                showCancelButton: true,
                                confirmButtonColor: '#3085d6',
                                cancelButtonColor: '#d33',
                                confirmButtonText: 'Yes, remove it!'
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    window.location.href = `/cart/remove?productId=${productId}`;
                                }
                            });
                            return; // Dừng logic ở đây, chờ user chọn
                        }
                    }

                    // Gọi API update số lượng
                    fetch('/cart/add', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                        },
                        body: new URLSearchParams({
                            'productId': productId,
                            'quantity': quantityToSend
                        })
                    })
                    .then(response => {
                        if (response.ok) {
                            location.reload();
                        } else {
                            Swal.fire("Error", "Something went wrong while updating cart.", "error");
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                    });
                });
            });

            // --- 2. HANDLE REMOVE BUTTON CLICK ---
            const removeButtons = document.querySelectorAll('.btn-remove-cart');
            removeButtons.forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    const productId = this.dataset.productId;

                    Swal.fire({
                        title: 'Are you sure?',
                        text: "You won't be able to revert this!",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Yes, delete it!'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = `/cart/remove?productId=${productId}`;
                        }
                    });
                });
            });

            // --- 3. HANDLE SAVE FOR LATER CLICK ---
            const saveLaterButtons = document.querySelectorAll('.btn-save-later');
            saveLaterButtons.forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    const productId = this.dataset.productId;

                    // Bước 1: Gọi API thêm vào Wishlist
                    fetch(`/wishlist/toggle?productId=${productId}`, {
                        method: 'POST'
                    })
                    .then(res => {
                        if (res.status === 401) {
                             Swal.fire("Login Required", "Please log in to use this feature.", "warning");
                             return null;
                        }
                        return res.json();
                    })
                    .then(data => {
                        if (data && (data.success || data.isLiked)) {
                            // Bước 2: Hiển thị thông báo thành công
                            Swal.fire({
                                icon: 'success',
                                title: 'Saved!',
                                text: 'Item has been moved to your wishlist.',
                                showConfirmButton: false,
                                timer: 1500
                            }).then(() => {
                                // Bước 3: Chuyển hướng để xóa khỏi giỏ hàng (Controller sẽ reload trang)
                                window.location.href = `/cart/remove?productId=${productId}`;
                            });
                        } else {
                             Swal.fire("Info", "This item is already in your wishlist or could not be added.", "info");
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        Swal.fire("Error", "Something went wrong.", "error");
                    });
                });
            });

        });
    </script>
}