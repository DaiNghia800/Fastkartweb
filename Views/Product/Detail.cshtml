@using Fastkart.Models.Entities;
@using System.Text.Json

@{
    Layout = "_Layout";
    ViewData["Title"] = "Product detail";
    var product = ViewBag.product as Product;
}

<section class="product-detail-hp">
    <div class="container">
        <div class="row g-4">
            <div class="col-xl-6">
                <div class="product-left-box">
                    <div class="row g-sm-4 g-2">
                        @{
                            var thumbnails = string.IsNullOrWhiteSpace(product.Thumbnail)
                            ? new List<string>()
                            : JsonSerializer.Deserialize<List<string>>(product.Thumbnail);

                            foreach (var thumbnail in thumbnails)
                            {
                                <div class="col-6 col-grid-box">
                                    <div class="slider-image w-100 h-100">
                                        <img src="@thumbnail" id="img-1" alt="@product.ProductName" class="img-flud w-100 h-100" />
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
            <div class="col-xl-6">
                <div class="right-box-contain p-sticky">
                    <h6 class="offer-top">30% Off</h6>
                    <h2 class="name">@product.ProductName</h2>
                    <div class="price-rating">
                        <h3 class="theme-color price">
                            @{
                                var priceNew = product.Price - (product.Price * product.Discount / 100);
                            }
                            @string.Format("{0:#,##0.##}", priceNew) đ
                            @if (product.Discount > 0)
                            {
                                <del>@string.Format("{0:#,##0.##}", product.Price) đ</del>
                                <span class="offer theme-color">(@product.Discount% off)</span>
                            }
                        </h3>
                        <div class="product-rating custom-rate">
                            <ul class="rating">
                                <li>
                                    <i class="fa-solid fa-star text-warning"></i>
                                </li>
                                <li>
                                    <i class="fa-solid fa-star text-warning"></i>
                                </li>
                                <li>
                                    <i class="fa-solid fa-star text-warning"></i>
                                </li>
                                <li>
                                    <i class="fa-solid fa-star text-warning"></i>
                                </li>
                                <li>
                                    <i class="fa-solid fa-star text-warning"></i>
                                </li>
                            </ul>
                            <span class="review">23 Customer Review</span>
                        </div>
                    </div>
                    <div class="product-contain">
                        <p>
                            @product.Description
                        </p>
                    </div>
                    <div class="product-package">
                        <div class="product-title">
                            <h4>Weight</h4>
                        </div>
                        <ul class="select-package">
                            <li><button class="active">@product.Weight Kg</button></li>
                        </ul>
                    </div>

                    <div class="note-box product-package">
                        <div class="cart_qty qty-box product-qty">
                            <div class="input-group">
                                <button type="button" class="qty-left-minus" onclick="updateMainQty(-1)">
                                    <i class="fa fa-minus"></i>
                                </button>
                                <input type="text" id="main-qty-input" class="form-control input-number qty-input" name="quantity" value="1" readonly />
                                <button type="button" class="qty-right-plus" onclick="updateMainQty(1)">
                                    <i class="fa fa-plus"></i>
                                </button>
                            </div>
                        </div>
                        <button onclick="addToCartMain(@product.Uid)" class="btn btn-md bg-dark cart-button text-white w-100">
                            Add To Cart
                        </button>
                    </div>
                    <div class="buy-box">
                        <a href="">
                            <i class="fa-regular fa-heart"></i>
                            <span>Add To Wishlist</span>
                        </a>
                        <a href="">
                            <i class="fa-solid fa-arrows-rotate"></i>
                            <span>Add To Compare</span>
                        </a>
                    </div>

                    <div class="pickup-box">
                        <div class="product-title">
                            <h4>Store Information</h4>
                        </div>
                        <div class="product-info">
                            <ul class="product-info-list">
                                <li>
                                    Type : <a href="">Black Forest</a>
                                </li>
                                <li>
                                    SKU : <a href="">@product.Sku</a>
                                </li>
                                <li>
                                    Stock : <a href="">@product.StockQuantity Items Left</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="product-detail-hp-box">
                    <ul class="nav nav-tabs custom-nav" id="myTab" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="description-tab" data-bs-toggle="tab"
                                    data-bs-target="#description" type="button" role="tab" aria-selected="true">
                                Description
                            </button>
                        </li>
                    </ul>
                    <div class="tab-content custom-tab" id="myTabContent">
                        <div class="tab-pane fade active show" id="description" role="tabpanel">
                            <div class="product-description">
                                <div class="nav-desh">
                                    @Html.Raw(product.Description)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@if (ViewBag.productRelated != null && ((List<Product>)ViewBag.productRelated).Count > 0)
{
    <section class="product-lists-section section-b-space">
        <div class="container-fluid-lg">
            <div class="title">
                <h2>Related Products</h2>
                <span class="title-leaf">
                    <i class="fa-solid fa-seedling"></i>
                </span>
            </div>
            <div class="row">
                <div class="col-12" style="padding:0;">
                    <div class="product-lists product-wrapper">
                        @foreach (Product item in ViewBag.productRelated)
                        {
                            <div class="product-box-3">
                                <div class="product-header">
                                    <div class="product-image">
                                        <a href="/product/detail/@item.Slug" tabindex="0">
                                            @{
                                                var thumbnailProduct = string.IsNullOrWhiteSpace(item.Thumbnail)
                                                ? new List<string>()
                                                : JsonSerializer.Deserialize<List<string>>(item.Thumbnail);

                                                var firstImg = thumbnailProduct.FirstOrDefault();
                                            }
                                            <img src="@firstImg" class="img-fluid" alt="@item.ProductName">
                                        </a>
                                        <ul class="product-option">
                                            <li><a href=""><i class="fa-regular fa-eye"></i></a></li>
                                            <li><a href=""><i class="fa-regular fa-heart"></i></a></li>
                                        </ul>
                                    </div>
                                </div>

                                <div class="product-footer">
                                    <div class="product-detail-hp">
                                        <span class="span-name">Product</span>
                                        <a href="/product/detail/@item.Slug" tabindex="0">
                                            <h5 class="name">@item.ProductName</h5>
                                        </a>
                                        <h5 class="price">
                                            @{
                                                var relatedPriceNew = item.Price - (item.Price * item.Discount / 100);
                                            }
                                            @string.Format("{0:#,##0.##}", relatedPriceNew) đ
                                        </h5>

                                        <div class="add-to-cart-box bg-white">
                                            <button class="btn btn-add-cart addcart-button" onclick="showQty(@item.Uid)" id="add-btn-@item.Uid" tabindex="0">
                                                Add
                                                <span class="add-icon bg-light-gray">
                                                    <i class="fa-solid fa-plus"></i>
                                                </span>
                                            </button>

                                            <div class="cart_qty qty-box" id="qty-box-@item.Uid" style="display:none;">
                                                <div class="input-group bg-white">
                                                    <button type="button" class="qty-left-minus bg-gray" onclick="updateQty(@item.Uid, -1)">
                                                        <i class="fa fa-minus"></i>
                                                    </button>

                                                    <input class="form-control input-number qty-input" type="text"
                                                           id="qty-input-@item.Uid" value="1" readonly>

                                                    <button type="button" class="qty-right-plus bg-gray" onclick="updateQty(@item.Uid, 1)">
                                                        <i class="fa fa-plus"></i>
                                                    </button>
                                                </div>
                                                <button class="btn btn-sm btn-animation w-100 mt-2" onclick="addToCart(@item.Uid)">OK</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>
}

@section Scripts {
    <script>
        // --- 1. XỬ LÝ SẢN PHẨM CHÍNH (MAIN PRODUCT) ---
        function updateMainQty(change) {
            var inputId = '#main-qty-input';
            var currentQty = parseInt($(inputId).val());
            var newQty = currentQty + change;
            if (newQty < 1) newQty = 1;
            $(inputId).val(newQty);
        }

        function addToCartMain(productId) {
            var quantity = parseInt($('#main-qty-input').val());
            callAddToCartApi(productId, quantity);
        }

        // --- 2. XỬ LÝ DANH SÁCH LIÊN QUAN (RELATED PRODUCTS) ---

        // Hàm hiển thị ô chọn số lượng khi bấm "Add"
        function showQty(productId) {
            $('.cart_qty').hide(); // Ẩn các ô nhập khác đang mở (nếu muốn)
            $('.addcart-button').show(); // Hiện lại các nút Add khác

            $('#add-btn-' + productId).hide(); // Ẩn nút Add của sản phẩm này
            $('#qty-box-' + productId).show(); // Hiện ô số lượng của sản phẩm này
        }

        // Hàm cập nhật số lượng (+/-) cho list
        function updateQty(productId, change) {
            var inputId = '#qty-input-' + productId;
            var currentQty = parseInt($(inputId).val());
            var newQty = currentQty + change;

            if (newQty < 1) newQty = 1;
            $(inputId).val(newQty);
        }

        // Hàm thêm vào giỏ từ list
        function addToCart(productId) {
            var quantity = parseInt($('#qty-input-' + productId).val());
            callAddToCartApi(productId, quantity);
        }

        // --- 3. HÀM GỌI AJAX CHUNG ---
        function callAddToCartApi(productId, quantity) {
            $.ajax({
                url: '/cart/add', // Đường dẫn đến Controller Cart
                type: 'POST',
                data: {
                    productId: productId,
                    quantity: quantity
                },
                success: function (response) {
                    if (response.success) {


                        // Reset giao diện nút Add trong list (nếu là thêm từ list)
                        if ($('#qty-box-' + productId).length) {
                            $('#add-btn-' + productId).show();
                            $('#qty-box-' + productId).hide();
                            $('#qty-input-' + productId).val(1);
                        }

                        // Cập nhật icon giỏ hàng trên header nếu cần (VD: gọi hàm cập nhật UI)
                        // updateHeaderCart(response.cartCount);
                        location.reload(); // Hoặc reload trang để thấy giỏ hàng cập nhật

                        Swal.fire("Success", "Item added to cart successfully!", "success");
                    } else {
                        alert(response.message || "Có lỗi xảy ra.");
                    }
                },
                error: function () {
                    alert("Lỗi kết nối đến server!");
                }
            });
        }
    </script>
}